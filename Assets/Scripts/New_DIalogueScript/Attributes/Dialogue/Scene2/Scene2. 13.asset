    - showAtTime: 0.1
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: b0a83c1970b921e49b4355e33f4cc1ed, type: 2}
      dialogueText: "Look here \u2014 our typhoon is moving toward land. What do
        you think will happen next?"
      voiceLine: {fileID: 0}
    - showAtTime: 8
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: afee438a6a0a92a4085cf9806948403f, type: 2}
      dialogueText: It gets weaker, right?
      voiceLine: {fileID: 0}
    - showAtTime: 11
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: 1c90d2f4fdae2a4408b42269ea4573b3, type: 2}
      dialogueText: 'But even if it weakens, it can still bring heavy rain and floods. '
      voiceLine: {fileID: 0}
    - showAtTime: 17
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: b0a83c1970b921e49b4355e33f4cc1ed, type: 2}
      dialogueText: "That\u2019s true, Aira. That\u2019s why we always need to prepare
        and stay safe \u2014 listen to weather updates, prepare emergency kits, and
        stay indoors during strong winds. "
      voiceLine: {fileID: 0}
    cinematicSFX: []
    onLineTriggered:
      m_PersistentCalls:
