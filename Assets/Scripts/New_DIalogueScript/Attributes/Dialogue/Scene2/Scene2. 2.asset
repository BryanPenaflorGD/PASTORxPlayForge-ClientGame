    cutsceneVideo: {fileID: 32900000, guid: 618cd4c887e434b43ab9943e0f1ecd10, type: 3}
    cinematicSubtitles:
    - showAtTime: 0.1
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: b0a83c1970b921e49b4355e33f4cc1ed, type: 2}
      dialogueText: "When the ocean water is warm \u2014 like in the Pacific Ocean
        or the South China Sea \u2014 it gives off lots of heat and moisture."
      voiceLine: {fileID: 0}
    - showAtTime: 9
      hideAfterSeconds: 0
      speaker: {fileID: 11400000, guid: b0a83c1970b921e49b4355e33f4cc1ed, type: 2}
      dialogueText: "That\u2019s why typhoons usually start there. But if the water
        is cool, like near land or in colder seas, the typhoon becomes weaker."
      voiceLine: {fileID: 0}
    - showAtTime: 22
      hideAfterSeconds: 8
      speaker: {fileID: 11400000, guid: b0a83c1970b921e49b4355e33f4cc1ed, type: 2}
      dialogueText: "Let\u2019s make our own mini typhoon! This warm water is like
        the ocean, the ice is cool air, and this fan is the wind. "
      voiceLine: {fileID: 0}
    cinematicSFX: []
    onLineTriggered:
      m_PersistentCalls:
        m_Calls: []
